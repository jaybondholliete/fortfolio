# Neon Postgres — use the POOLED connection string from the Neon dashboard
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Salt for SHA-256 hashing of client IPs before storage. Generate one:
#   python -c "import secrets;print(secrets.token_hex(32))"
IP_HASH_SALT=

# Optional extra CORS origins (comma-separated). Defaults already cover
# https://jaybondholliete.github.io and localhost dev servers.
ALLOWED_ORIGINS=
